    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch C# (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BuildNetworkExample/bin/Debug/net8.0/BuildNetworkExample.dll",
            "args": [
                "--tNavPath",
                "~/tNavigator/24.4/tNavigator-con",
                "--action",
                "3"
            ],
            "cwd": "${workspaceFolder}/BuildNetworkExample",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": ".NET Core Launch C#WithDebugger (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BuildNetworkExample/bin/Debug/net8.0/BuildNetworkExample.dll",
            "args": [],
            "cwd": "${workspaceFolder}/BuildNetworkExample",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}